# Drop Cowboy Starter CRM. Copy to .env (git ignores it) and fill in what your
# auth mode needs. Both starter servers (server/node and server/python) read
# this one file. Variables already set in your shell win over this file.
# Or run `npm run setup`, which writes .env with mode 0600.

# How the browser gets its site token:
#   server       This server mints tokens with your API key. The production pattern.
#                (default — use this until "Sign in with Drop Cowboy" ships)
#   mcp-session  Your AI agent minted a token into .dropcowboy/session.json. Dev only.
#   login        You sign in with Drop Cowboy; this server mints the token with
#                your sign-in. No API key needed. Coming soon: needs AUTH0_CLIENT_ID.
# Allowed: server | mcp-session | login. Wrong value → boot code invalid_auth_mode.
DC_AUTH_MODE=server

# Runtime environment. Deploy templates set production.
# Allowed: development | production. Wrong value → boot code invalid_env.
# production + DC_IDENTITY=dev → boot code production_dev_identity.
# production + mcp-session → boot code production_mcp_session.
DC_ENV=development

# Who your app's user is in server mode. Only valid with DC_AUTH_MODE=server.
#   dev       Everyone is the user in STARTER_CRM_USER_ID. Local only: production refuses it.
#   passcode  One shared passcode (DC_PASSCODE) signs in; an HttpOnly cookie keeps you in for 12 hours.
#   oidc      A bearer token from your sign-in provider (Auth0, Clerk, Supabase, Firebase, ...).
#             Set DC_OIDC_ISSUER and DC_OIDC_AUDIENCE. CUSTOMIZE.md has a recipe for each.
#   ./my-identity.js (or .py)  Your own provider; see docs/providers/identity.md.
# Allowed: dev | passcode | oidc | a relative path. Wrong value → boot code invalid_identity.
DC_IDENTITY=dev

# passcode identity: the shared passcode, at least 12 characters. SECRET.
# Missing → missing_passcode. Too short → weak_passcode.
DC_PASSCODE=

# oidc identity. The issuer must be https (plain http only for localhost) and equal
# the token's "iss". The audience must be in the token's "aud".
# Missing → missing_oidc_issuer / missing_oidc_audience. Bad URL → invalid_oidc_issuer.
DC_OIDC_ISSUER=
DC_OIDC_AUDIENCE=
# Optional. Empty means the key set is found from <issuer>/.well-known/openid-configuration.
# Bad URL → invalid_oidc_jwks_url.
DC_OIDC_JWKS_URL=

# Public origin (no path) browsers and Drop Cowboy use to reach this server.
# Example: https://crm.example.com. Optional locally. doctor checks /healthz.
# Wrong shape → boot code invalid_public_url.
DC_PUBLIC_URL=

# Hop count for X-Forwarded-* behind a reverse proxy. 0 = do not trust them.
# Allowed: 0–32. Wrong value → boot code invalid_trust_proxy.
DC_TRUST_PROXY=0

# How long SIGTERM waits for open SSE streams and in-flight requests (seconds).
# Allowed: 1–300. Default 10. Wrong value → boot code invalid_shutdown_grace.
DC_SHUTDOWN_GRACE_SECONDS=10

# --- login and server modes --------------------------------------------------
# REQUIRED in both: the server will not start without it.
# One UUID per deployed app. Keep it stable: it partitions the embed inbox.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# Missing → missing_site_id. Not a UUID → invalid_site_id.
DROPCOWBOY_SITE_ID=

# --- login mode --------------------------------------------------------------
# Public values for "Sign in with Drop Cowboy". The client id identifies a
# public single-page app (no client secret exists), so it is safe in a browser.
# The browser sends the access token it gets to this server, which forwards it
# to Drop Cowboy to mint. The server never logs or stores it.
AUTH0_DOMAIN=login.dropcowboy.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api-v2.dropcowboy.com

# --- server mode -------------------------------------------------------------
# An API key from Developers > API keys in the Drop Cowboy dashboard. Needs the
# numbers:write scope (to mint site tokens) and balance:read (for /setup).
# Not used in login mode.
# SECRET: never commit these or send them to a browser.
# Missing → missing_api_key / missing_api_secret.
DROPCOWBOY_API_KEY=
DROPCOWBOY_API_SECRET=

# The user in the dev identity (the default). Becomes the `sub` of every token.
# Any UUID works for local testing. With the passcode identity it is optional and
# names the one passcode user. The oidc identity ignores it: the token names the user.
# Missing with dev → missing_user_id. Not a UUID → invalid_user_id.
# SAMPLE_USER_ID is not accepted (renamed_env); use this name only.
STARTER_CRM_USER_ID=8b6f4c2a-1d3e-4f5a-9b7c-0e2d4f6a8c1e

# --- webhooks ----------------------------------------------------------------
# The signing_secret returned when you created a webhook. Each webhook has its
# own secret, so list them comma-separated.
# SECRET.
DROPCOWBOY_WEBHOOK_SECRET=

# --- events: storage, fan-out and handlers -----------------------------------
# Where webhook events are kept. They feed the activity stream (/api/events), the
# failed-handler list and replay.
#   memory    In this process. Lost on restart, one instance only. The default.
#   sqlite    A file (DC_SQLITE_PATH). Survives restarts. One machine only.
#   postgres  Shared by every instance (DC_DATABASE_URL).
#   redis     Shared by every instance (DC_REDIS_URL). Use noeviction and AOF.
#   dynamodb  One DynamoDB table shared by every instance (AWS_REGION, DC_DYNAMODB_TABLE).
#   ./my-store.js (or .py)  Your own; see docs/providers/store.md.
# Wrong value → invalid_store. Needs a setting that is missing → missing_database_url,
# missing_redis_url or missing_aws_region.
DC_STORE=memory
DC_SQLITE_PATH=data/starter-crm.sqlite
# SECRET (it holds a password). DATABASE_URL is read when this is empty, then NETLIFY_DB_URL,
# which Netlify Database sets on Netlify.
DC_DATABASE_URL=
# SECRET when it holds a password. Redis or Valkey: redis://host:6379 or rediss://host:6379.
DC_REDIS_URL=
# on when DC_REDIS_URL is one node of a Redis Cluster (ElastiCache cluster mode). Empty or off
# means one server. Wrong value → invalid_redis_cluster. The Python server cannot run
# DC_WEBHOOKS=bullmq on a cluster (bullmq_cluster_unsupported).
DC_REDIS_CLUSTER=

# AWS (DC_STORE=dynamodb, DC_DATA=dynamodb, DC_WEBHOOKS=sqs, DC_SECRETS=aws-*). The AWS SDK finds
# credentials itself (on ECS, the task role); nothing secret goes here. No region → missing_aws_region.
AWS_REGION=
# Send AWS requests to a stand-in (dynamodb-local, ElasticMQ). https in production, localhost excepted.
AWS_ENDPOINT_URL=
# The DynamoDB table; the CloudFormation template creates it. Bad name → invalid_dynamodb_table.
DC_DYNAMODB_TABLE=
# on lets the server create the table when it is missing. For a local stand-in only.
DC_DYNAMODB_AUTO_CREATE=off
# DC_WEBHOOKS=sqs: the queue's URL. Missing → missing_sqs_queue_url.
DC_SQS_QUEUE_URL=

# Where your modules (Deals and the ones you add) keep their data, in DC_AUTH_MODE=server.
#   (empty)   Follows DC_STORE: memory, sqlite or postgres use the same database.
#   memory    In this process, until it restarts.
#   sqlite    A file (DC_SQLITE_PATH).
#   postgres  Shared by every instance (DC_DATABASE_URL).
#   dynamodb  The same DynamoDB table as the event store.
#   ./my-data.js (or .py)  Your own; see docs/providers/data.md.
# DC_STORE=redis (or your own store) needs this set: data_provider_required.
# Wrong value → invalid_data.
DC_DATA=

# In DC_ENV=production a remote Redis or Postgres must use TLS (rediss://, sslmode=require).
# Set this to on only when they sit on a private network you control, such as the
# Compose network. It lifts that check for both; it does not turn TLS off anywhere.
DC_INSECURE_PRIVATE_SERVICES=off

# How an event finished on one instance reaches browsers on the others.
#   local     Same process only. The default with DC_STORE=memory.
#   poll      Each instance polls the store. The default for sqlite, postgres, redis and dynamodb stores.
#   redis     Redis pub/sub. Needs DC_REDIS_URL.
#   postgres  LISTEN/NOTIFY. Needs DC_STORE=postgres.
# Wrong value → invalid_fanout. Needs a shared store → store_not_shared / fanout_needs_postgres.
DC_FANOUT=
DC_FANOUT_POLL_MS=1000

# How webhook handlers run after the event is stored.
#   store    An outbox in the event store, handled by a worker. The default.
#   bullmq   A Redis queue shared by Node and Python workers. The default with a durable store
#            and DC_REDIS_URL.
#   sqs      An Amazon SQS queue (DC_SQS_QUEUE_URL), shared by Node and Python workers. The default
#            with DC_STORE=dynamodb and a queue URL, when there is no DC_REDIS_URL.
#   vercel-queue  Vercel Queues, on Vercel only (Node server). The default there.
#   netlify-async  Netlify Async Workloads, on Netlify only (Node server). The default there.
#   qstash   Upstash QStash calls the app back (QSTASH_* below). The fallback on Vercel and Netlify.
#   inline   In the request. A failing handler answers 503, so Drop Cowboy retries.
# Wrong value → invalid_webhooks_mode.
DC_WEBHOOKS=
# DC_WEBHOOKS=qstash: from the Upstash QStash page. The tokens are SECRETS. DC_PUBLIC_URL is the address QStash calls back.
# Missing → missing_qstash_setting / missing_qstash_public_url. QSTASH_URL is only for a stand-in.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
# Vercel only: the secret Vercel Cron sends to /internal/maintenance (16 or more characters). SECRET.
CRON_SECRET=
# DC_WEBHOOKS=netlify-async: the key the Async Workloads router asks for. On Netlify it is set for you
# (by the extension, or when you create a key for the site on a Starter team). SECRET.
# Missing → missing_awl_api_key.
AWL_API_KEY=
# A relative path to your handlers file (server/node/src/handlers.js shows the shape). Empty means none.
DC_WEBHOOK_HANDLERS=
# A failed handler is retried with backoff, then marked failed after this many attempts (1-50).
DC_WEBHOOK_MAX_ATTEMPTS=8
# Inline mode only: how long handlers may run before the request answers (100-4500 ms).
DC_WEBHOOK_HANDLER_BUDGET_MS=3000
DC_OUTBOX_POLL_MS=1000
# on runs the worker inside the web process. off leaves it to `npm run worker`, which
# needs a shared store and a fan-out that reaches across processes.
DC_WORKER_IN_PROCESS=on

# Finished events are deleted after this many hours (1-8760). A contact.deleted event also
# removes that contact's other events at once.
DC_EVENT_RETENTION_HOURS=72
# Close each activity stream after this many seconds so clients reconnect (0 = never, max 86400).
# Empty means 0, or 290 on Vercel and 25 on Netlify.
DC_EVENTS_MAX_STREAM_SECONDS=0

# --- security, limits and logs -----------------------------------------------
# Content-Security-Policy. report-only watches without blocking; enforce blocks; off sends none.
# Wrong value → boot code invalid_csp.
DC_CSP=report-only

# Origins (comma-separated, no path) allowed to call this API from another site.
# Empty turns CORS off. "*" is not accepted. Wrong value → invalid_cors_origins.
DC_CORS_ORIGINS=

# Rate limits on the token route, sign-in and the dev session route.
#   memory  Counts in this process. Fine for one server. The default without DC_REDIS_URL.
#   redis   Counts in Redis (DC_REDIS_URL), so every instance shares one limit. The default
#           when DC_REDIS_URL is set.
#   off     No limits (tests, or a limit your proxy already enforces).
#   ./my-limiter.js (or .py)  Your own limiter.
# Wrong value → boot code invalid_rate_limit. redis without DC_REDIS_URL → missing_redis_url.
DC_RATE_LIMIT=memory

# Reuse each user's minted site token until a minute before it expires (server mode).
# Allowed: on | off. Wrong value → boot code invalid_token_cache.
DC_TOKEN_CACHE=on

# Log lines: "pretty" for people, "json" for log tools. Default json when DC_ENV=production.
# Wrong value → boot code invalid_log_format.
DC_LOG_FORMAT=

# One access-log line per request. Default on in production, off otherwise.
# Wrong value → boot code invalid_log_requests.
DC_LOG_REQUESTS=

# Where log lines go: "console", or a relative path to your own sink (docs/providers/log.md).
# Anything else → boot code invalid_log_provider.
DC_LOG=console

# A relative path to your own observer (Sentry, OpenTelemetry, metrics). Empty means none.
# See docs/providers/observer.md and CUSTOMIZE.md. Not a path → boot code invalid_observer.
DC_OBSERVER=

# --- secrets -----------------------------------------------------------------
# Where secrets (API key and secret, webhook secrets, the passcode) come from.
#   env   Environment variables and this file. The default.
#   file  One file per secret in DC_SECRETS_DIR, named like the variable (Docker and
#         Kubernetes mounted secrets). The server warns about world-readable files;
#         chmod 600 them. Missing or unreadable folder → missing_secrets_dir.
#   doppler | infisical | vault | 1password | aws-secrets-manager | aws-ssm  A secret manager
#         (docs/providers/secrets.md).
#         Each needs the settings below, and a credential for the manager that comes from
#         the host's own environment, never from this file.
#   ./my-secrets.js (or .py)  Your own provider, for a vault or secret manager.
# Wrong value → boot code invalid_secrets_provider. A path that will not load → invalid_provider.
DC_SECRETS=env
DC_SECRETS_DIR=
# Doppler: also needs the service token in DOPPLER_TOKEN. Empty address is the Doppler cloud.
# Missing token → missing_doppler_token. Not https (loopback excepted) → invalid_secrets_url.
DOPPLER_API_URL=
# Infisical: also needs INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET and INFISICAL_PROJECT_ID.
# Missing → missing_infisical_setting. Empty URL is Infisical cloud; empty environment is prod.
INFISICAL_URL=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=
# Vault or OpenBao (KV v2): VAULT_ADDR and VAULT_PATH, plus VAULT_TOKEN, or VAULT_ROLE_ID with
# VAULT_SECRET_ID. Missing → missing_vault_setting. Both kinds → invalid_vault_auth.
# Bad path → invalid_vault_path. Empty mount is "secret", empty AppRole mount is "approle".
VAULT_ADDR=
VAULT_PATH=
VAULT_MOUNT=
VAULT_APPROLE_MOUNT=
VAULT_NAMESPACE=
# 1Password: also needs OP_SERVICE_ACCOUNT_TOKEN. Missing → missing_onepassword_setting.
# OP_ITEM empty means one item per secret. Bad name → invalid_onepassword_setting.
OP_VAULT=
OP_ITEM=
# aws-secrets-manager: DC_AWS_SECRET_ID, the name or ARN of one secret holding a JSON object.
# Missing → missing_aws_secret_id. aws-ssm: DC_AWS_SSM_PATH, such as /starter-crm (SecureString
# parameters named <path>/<NAME>). Missing → missing_aws_ssm_path; bad shape → invalid_aws_ssm_path.
DC_AWS_SECRET_ID=
DC_AWS_SSM_PATH=
# How often a provider that can refresh re-reads (seconds). 0 turns refreshing off.
# Whole number 0 to 86400 or so; wrong value → invalid_secrets_refresh.
DC_SECRETS_REFRESH_SECONDS=300

# --- optional ----------------------------------------------------------------
# Default https://api-v2.dropcowboy.com. Must be http(s). Wrong → invalid_api_base.
DROPCOWBOY_API_BASE=https://api-v2.dropcowboy.com
# Pin the widget CDN version. Empty uses the front-end's built-in default.
DC_CDN_VERSION=

# Loopback by default. Only change HOST if you understand who can reach it.
# PORT wrong → invalid_port.
HOST=127.0.0.1
PORT=8080
