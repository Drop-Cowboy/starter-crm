# Drop Cowboy Starter CRM. Copy to .env (git ignores it) and fill in what your
# auth mode needs. Both starter servers (server/node and server/python) read
# this one file. Variables already set in your shell win over this file.

# How the browser gets its site token:
#   server       This server mints tokens with your API key. The production pattern.
#                (default — use this until "Sign in with Drop Cowboy" ships)
#   mcp-session  Your AI agent minted a token into .dropcowboy/session.json. Dev only.
#   login        You sign in with Drop Cowboy; this server mints the token with
#                your sign-in. No API key needed. Coming soon: needs AUTH0_CLIENT_ID.
DC_AUTH_MODE=server

# --- login and server modes --------------------------------------------------
# REQUIRED in both: the server will not start without it.
# One UUID per deployed app. Keep it stable: it partitions the embed inbox.
# Generate one with: node -e "console.log(crypto.randomUUID())"
DROPCOWBOY_SITE_ID=

# --- login mode --------------------------------------------------------------
# Public values for "Sign in with Drop Cowboy". The client id identifies a
# public single-page app (no client secret exists), so it is safe in a browser.
# The browser sends the access token it gets to this server, which forwards it
# to Drop Cowboy to mint. The server never logs or stores it.
AUTH0_DOMAIN=login.dropcowboy.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api-v2.dropcowboy.com

# --- server mode -------------------------------------------------------------
# An API key from Developers > API keys in the Drop Cowboy dashboard. Needs the
# numbers:write scope (to mint site tokens) and balance:read (for /setup).
# Not used in login mode.
# SECRET: never commit these or send them to a browser.
DROPCOWBOY_API_KEY=
DROPCOWBOY_API_SECRET=

# Stands in for your signed-in CRM user until you replace requireUser() in the
# server. Becomes the `sub` of every token. Any UUID works for local testing.
STARTER_CRM_USER_ID=8b6f4c2a-1d3e-4f5a-9b7c-0e2d4f6a8c1e

# --- webhooks ----------------------------------------------------------------
# The signing_secret returned when you created a webhook. Each webhook has its
# own secret, so list them comma-separated.
# SECRET.
DROPCOWBOY_WEBHOOK_SECRET=

# --- optional ----------------------------------------------------------------
DROPCOWBOY_API_BASE=https://api-v2.dropcowboy.com
# Pin the widget CDN version. Empty uses the front-end's built-in default.
DC_CDN_VERSION=

# Loopback by default. Only change HOST if you understand who can reach it.
HOST=127.0.0.1
PORT=8080
