{
    "name": "Starter CRM",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.13"
        }
    },
    "postCreateCommand": "npm run setup -- --yes",
    "forwardPorts": [8080, 5173],
    "portsAttributes": {
        "8080": {
            "label": "Starter CRM server",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "React dev server",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "charliermarsh.ruff"
            ]
        }
    },
    "remoteEnv": {
        "PYTHON": "python3"
    }
}
