{
  "description": "Request-body schema cases both servers must judge the same way: the first problem found (null when the value fits), in the order the CONTRACT.md 'Input validation' section lists.",
  "cases": [
    { "name": "fits", "schema": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string", "minLength": 1 } } }, "value": { "title": "x" }, "problem": null },
    { "name": "body must be an object", "schema": { "type": "object" }, "value": [], "problem": "body: must be an object" },
    { "name": "null is not an object", "schema": { "type": "object" }, "value": null, "problem": "body: must be an object" },
    { "name": "missing required field", "schema": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" } } }, "value": {}, "problem": "title: is required" },
    { "name": "required is checked before property types", "schema": { "type": "object", "required": ["b"], "properties": { "a": { "type": "string" }, "b": { "type": "string" } } }, "value": { "a": 1 }, "problem": "b: is required" },
    { "name": "string type", "schema": { "type": "object", "properties": { "title": { "type": "string" } } }, "value": { "title": 5 }, "problem": "title: must be a string" },
    { "name": "integer type rejects a fraction", "schema": { "type": "object", "properties": { "n": { "type": "integer" } } }, "value": { "n": 1.5 }, "problem": "n: must be an integer" },
    { "name": "integer type accepts an integral float", "schema": { "type": "object", "properties": { "n": { "type": "integer" } } }, "value": { "n": 5.0 }, "problem": null },
    { "name": "integer type rejects a boolean", "schema": { "type": "object", "properties": { "n": { "type": "integer" } } }, "value": { "n": true }, "problem": "n: must be an integer" },
    { "name": "boolean type", "schema": { "type": "object", "properties": { "flag": { "type": "boolean" } } }, "value": { "flag": "yes" }, "problem": "flag: must be a boolean" },
    { "name": "type list allows null", "schema": { "type": "object", "properties": { "c": { "type": ["string", "null"], "format": "uuid" } } }, "value": { "c": null }, "problem": null },
    { "name": "type list names every type", "schema": { "type": "object", "properties": { "c": { "type": ["string", "null"] } } }, "value": { "c": 4 }, "problem": "c: must be a string or null" },
    { "name": "enum", "schema": { "type": "object", "properties": { "stage": { "type": "string", "enum": ["lead", "won"] } } }, "value": { "stage": "x" }, "problem": "stage: must be one of lead, won" },
    { "name": "minLength", "schema": { "type": "object", "properties": { "t": { "type": "string", "minLength": 1 } } }, "value": { "t": "" }, "problem": "t: must be at least 1 character" },
    { "name": "minLength plural", "schema": { "type": "object", "properties": { "t": { "type": "string", "minLength": 3 } } }, "value": { "t": "ab" }, "problem": "t: must be at least 3 characters" },
    { "name": "maxLength", "schema": { "type": "object", "properties": { "t": { "type": "string", "maxLength": 2 } } }, "value": { "t": "abc" }, "problem": "t: must be at most 2 characters" },
    { "name": "maxLength counts code points", "schema": { "type": "object", "properties": { "t": { "type": "string", "maxLength": 1 } } }, "value": { "t": "😀" }, "problem": null },
    { "name": "format uuid accepts a uuid", "schema": { "type": "object", "properties": { "c": { "type": "string", "format": "uuid" } } }, "value": { "c": "5a4b3c2d-1e0f-4a9b-8c7d-6e5f4a3b2c1d" }, "problem": null },
    { "name": "format uuid rejects text", "schema": { "type": "object", "properties": { "c": { "type": "string", "format": "uuid" } } }, "value": { "c": "nope" }, "problem": "c: must be a UUID" },
    { "name": "pattern matches the whole string", "schema": { "type": "object", "properties": { "cur": { "type": "string", "pattern": "[A-Z]{3}" } } }, "value": { "cur": "USDX" }, "problem": "cur: has the wrong format" },
    { "name": "pattern is not fooled by a trailing newline", "schema": { "type": "object", "properties": { "cur": { "type": "string", "pattern": "[A-Z]{3}" } } }, "value": { "cur": "USD\n" }, "problem": "cur: has the wrong format" },
    { "name": "pattern accepts a match", "schema": { "type": "object", "properties": { "cur": { "type": "string", "pattern": "[A-Z]{3}" } } }, "value": { "cur": "USD" }, "problem": null },
    { "name": "minimum", "schema": { "type": "object", "properties": { "n": { "type": "integer", "minimum": 0 } } }, "value": { "n": -1 }, "problem": "n: must be at least 0" },
    { "name": "maximum", "schema": { "type": "object", "properties": { "n": { "type": "integer", "maximum": 10 } } }, "value": { "n": 11 }, "problem": "n: must be at most 10" },
    { "name": "additionalProperties false", "schema": { "type": "object", "properties": { "a": { "type": "string" } }, "additionalProperties": false }, "value": { "a": "x", "z": 1 }, "problem": "z: is not allowed" },
    { "name": "extras are reported in sorted order", "schema": { "type": "object", "properties": {}, "additionalProperties": false }, "value": { "z": 1, "b": 2 }, "problem": "b: is not allowed" },
    { "name": "minProperties", "schema": { "type": "object", "minProperties": 1, "properties": { "a": { "type": "string" } } }, "value": {}, "problem": "body: must have at least 1 field" },
    { "name": "properties are checked in declaration order", "schema": { "type": "object", "properties": { "a": { "type": "string" }, "b": { "type": "string" } } }, "value": { "b": 1, "a": 2 }, "problem": "a: must be a string" },
    { "name": "array items", "schema": { "type": "object", "properties": { "tags": { "type": "array", "items": { "type": "string" } } } }, "value": { "tags": ["a", 2] }, "problem": "tags[1]: must be a string" },
    { "name": "maxItems", "schema": { "type": "object", "properties": { "tags": { "type": "array", "maxItems": 1 } } }, "value": { "tags": ["a", "b"] }, "problem": "tags: must have at most 1 item" },
    { "name": "an array is not an object", "schema": { "type": "object", "properties": { "a": { "type": "object" } } }, "value": { "a": [] }, "problem": "a: must be an object" }
  ]
}
